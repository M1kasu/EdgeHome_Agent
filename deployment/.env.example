# 不要把真实 Token 提交到仓库；Home Assistant 的认证由其配置流程管理。
TZ=Asia/Shanghai
HA_PORT=8123
MODEL_PORT=8080
MODELS_DIR=./models
# 选择本机已有的 1B-3B GGUF Q4/Q8 量化模型。
MODEL_PATH=/models/your-model-q4_k_m.gguf
MODEL_CONTEXT_SIZE=2048
HA_URL=http://home-assistant:8123
HA_TOKEN=
MODEL_URL=http://llama-server:8080
MAX_PLAN_STEPS=12
DATABASE_PATH=/config/.storage
KNOWLEDGE_PATH=/config/.storage/edgehome_knowledge.sqlite
