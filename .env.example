# 默认启用模拟家庭，可在无 Home Assistant、无网络环境下运行。
EDGEHOME_SIMULATION=true
EDGEHOME_DATA_DIR=data
EDGEHOME_MAX_PLAN_STEPS=12
EDGEHOME_PROACTIVE_SERVICE=false

# 接入真实 Home Assistant 时配置；令牌只由服务端读取，绝不传入模型提示词。
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=replace-me

# 可选：llama.cpp OpenAI 兼容服务地址。未配置时使用内置场景模板规划。
# EDGEHOME_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
