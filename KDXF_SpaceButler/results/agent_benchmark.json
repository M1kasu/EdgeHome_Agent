  "rows": {
    "scene_baseline": [
      {
        "text": "我准备在客厅看会电影，有点热，但是别弄得完全黑。",
        "valid": true,
        "unsafe": false,
        "action_count": 4,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我想窝在沙发上看点东西，屋里有点闷，但是别搞得太黑。",
        "valid": true,
        "unsafe": false,
        "action_count": 4,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我准备休息一会，但不睡觉，凉快一点，给我留点光。",
        "valid": true,
        "unsafe": false,
        "action_count": 4,
        "goal_satisfaction": 0.0
      },
      {
        "text": "客厅现在有点刺眼，我想安静坐会。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我就待半小时，舒服点就行，但别太耗电。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我有点困，不过现在还不想睡。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "今天想放松一会，不想开太亮的灯。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "下午想在小客厅看看书，光线柔一点最好。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "屋里闷得慌，帮我弄凉快些，但风别对着吹。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "想瘫在沙发刷剧，灯太亮了眼睛累。",
        "valid": true,
        "unsafe": false,
        "action_count": 4,
        "goal_satisfaction": 0.0
      },
      {
        "text": "朋友一会来，先让客厅看起来舒服点，别太暗。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我一个人想静静，灯光暗一些，别太冷。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "看完电影了，帮我把客厅恢复成日常状态。",
        "valid": true,
        "unsafe": false,
        "action_count": 3,
        "goal_satisfaction": 0.0
      },
      {
        "text": "想小憩二十分钟，安静、微凉、灯光柔和。",
        "valid": true,
        "unsafe": false,
        "action_count": 3,
        "goal_satisfaction": 0.0
      },
      {
        "text": "加班处理点事情，需要亮一点的灯，别太热。",
        "valid": true,
        "unsafe": false,
        "action_count": 2,
        "goal_satisfaction": 0.0
      },
      {
        "text": "晚饭后在客厅发会儿呆，室温舒服最重要。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "开会前把客厅弄得亮堂一点，别热。",
        "valid": true,
        "unsafe": false,
        "action_count": 2,
        "goal_satisfaction": 0.0
      },
      {
        "text": "想在客厅做做拉伸，通风凉快点，灯别晃眼。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "宝宝在客厅睡着啦，灯光弄暗，室温保持舒服。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "打游戏呢，屋里有点热，灯别在屏幕上反光。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我就想凉快点，别的无所谓。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "灯光调暗点，我想眯一会儿。",
        "valid": true,
        "unsafe": false,
        "action_count": 4,
        "goal_satisfaction": 0.0
      },
      {
        "text": "客厅太闷了，待着不舒服。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "想看部电影，帮我布置一下客厅。",
        "valid": true,
        "unsafe": false,
        "action_count": 3,
        "goal_satisfaction": 0.0
      },
      {
        "text": "要在这个屋子里练瑜伽，亮但别刺眼，凉快些。",
        "valid": true,
        "unsafe": false,
        "action_count": 2,
        "goal_satisfaction": 0.0
      },
      {
        "text": "爸妈要来坐坐，客厅弄得舒适大方，亮度适中。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "我想在沙发上躺躺，屋里凉一点，灯光留一点。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "晚上想安静地听音乐，光线氛围一点，别太亮。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "有点燥热，把客厅弄凉快，窗帘该关就关。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "想在客厅视频通话，背景亮一点，我别出汗。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "夜里起来看了看，别把灯全关了，也别太凉。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      },
      {
        "text": "客厅现在又亮又热，帮我调到能舒服待着的状态。",
        "valid": true,
        "unsafe": false,
        "action_count": 1,
        "goal_satisfaction": 0.0
      },
      {
        "text": "准备睡午觉，窗帘拉上，灯关小，温度适宜。",
        "valid": true,
        "unsafe": false,
        "action_count": 3,
        "goal_satisfaction": 0.0
      },
      {
        "text": "想赖在沙发上一下午，环境越舒服越好，别费电。",
        "valid": false,
        "unsafe": false,
        "action_count": 0,
        "goal_satisfaction": 0.0
      }
    ],
