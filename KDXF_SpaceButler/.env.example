# Copy to .env only if .env does not already exist. Never commit real secrets.
# The launcher reads this project's .env; shell environment variables take precedence.

# Doubao speech API (no general cloud AccessKeyID / SecretAccessKey required).
SPACEBUTLER_ASR_API_KEY=
SPACEBUTLER_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
SPACEBUTLER_ASR_ENABLE_NONSTREAM=true

# Real Home Assistant + existing ESPHome nodes. Set the actual addresses for your setup.
SPACEBUTLER_HA_URL=http://127.0.0.1:12900
# SPACEBUTLER_HA_PORT=12900
ESPHOME_HOST=192.168.111.134
# Paste the EXISTING api_encryption_key from the Ubuntu ESPHome secrets.yaml.
# Must decode to exactly 32 bytes; never generate a replacement for running nodes.
ESPHOME_NOISE_PSK=
# Optional: token for an already configured Home Assistant instance.
# HA_TOKEN=

# Optional exact HA entity IDs for renamed or ambiguous devices.
# Set only the entries needed; a missing configured entity never falls back.
# SPACEBUTLER_ENTITY_LIGHT=light.actual_entity_id
# SPACEBUTLER_ENTITY_CURTAIN=cover.actual_entity_id
# SPACEBUTLER_ENTITY_CLIMATE=climate.actual_entity_id
# SPACEBUTLER_ENTITY_PRESENCE=binary_sensor.actual_entity_id
# SPACEBUTLER_ENTITY_TEMPERATURE=sensor.actual_entity_id
# 卧室节点与客厅辅助节点（原 MQTT 设备迁入后的固件实体）。
# 若 HA 里还残留同名旧实体，显式绑定可避免匹配歧义。
# SPACEBUTLER_ENTITY_BEDROOM_LIGHT=light.bedroom_reading_light
# SPACEBUTLER_ENTITY_BEDROOM_PRESENCE=binary_sensor.bedroom_presence
# SPACEBUTLER_ENTITY_BEDROOM_ILLUMINANCE=sensor.bedroom_illuminance
# SPACEBUTLER_ENTITY_TV=switch.living_room_tv
# SPACEBUTLER_ENTITY_TV_POWER=sensor.living_room_tv_power
# SPACEBUTLER_ENTITY_WINDOW=binary_sensor.living_room_window

# ---- 双通道规划模型 ----------------------------------------------------
# 云端通道（快）：填入 Key 后自动启用，失败/超时/限流会即时回落本地边缘模型。
# 不填 Key 时整条云通道跳过，行为与改造前完全一致。
ANTHROPIC_API_KEY=
# 可选覆盖项。effort 越低越快；本项目的规划是按 schema 填空的有界任务，medium 足够。
# SPACEBUTLER_CLOUD_MODEL=claude-opus-5
# SPACEBUTLER_CLOUD_EFFORT=medium
# SPACEBUTLER_CLOUD_FAST=true
# SPACEBUTLER_CLOUD_TIMEOUT=25
# SPACEBUTLER_CLOUD_ENABLED=false

# 本地边缘通道（兜底）：断网、限流或未配 Key 时由它完成规划。
SPACEBUTLER_LLM_BASE_URL=http://127.0.0.1:12881
SPACEBUTLER_LLM_TIMEOUT=240
# SPACEBUTLER_LLM_MODEL=
# SPACEBUTLER_LLM_API_KEY=
# SPACEBUTLER_LLM_TEMPERATURE=0.1
EDGE_LLM_URL=http://127.0.0.1:12881

# Optional Compose overrides: adjust to a model file that actually exists.
# SPACEBUTLER_MODELS_DIR=D:/Models
# SPACEBUTLER_MODEL_PATH=/models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
# SPACEBUTLER_MODEL_PORT=12881
